generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  timezone     String   @default("Asia/Shanghai")
  preferences  String   @default("{}")
  autoBatch    Boolean  @default(false)
  batchSize    Int      @default(5)
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  @@index([userId])
}

model Account {
  id       String @id @default(cuid())
  ownerId  String
  name     String
  opening  Int    @default(0)
  archived Boolean @default(false)
  version  Int @default(1)
  @@index([ownerId])
}

model Category {
  id       String @id @default(cuid())
  ownerId  String
  name     String
  type     String
  archived Boolean @default(false)
  version  Int @default(1)
  @@unique([ownerId, type, name])
}

model CategoryRule {
  id String @id @default(cuid())
  ownerId String
  keyword String
  categoryId String
  @@unique([ownerId, keyword])
}

model LedgerEntry {
  id          String   @id @default(cuid())
  ownerId     String
  type        String
  title       String
  amount      Int
  date        String
  accountId   String?
  toAccountId String?
  categoryId  String?
  refundOfId  String?
  discount    Int      @default(0)
  grossAmount Int?
  discountDetails String @default("")
  autoSaving  Boolean  @default(true)
  orderKey    String?
  note        String   @default("")
  sourceDraftId String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([ownerId, date])
  @@index([refundOfId])
}

model ShoppingList {
  id String @id @default(cuid())
  ownerId String
  name String
  description String @default("")
  archived Boolean @default(false)
  sort Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([ownerId])
}

model ShoppingItem {
  id String @id @default(cuid())
  ownerId String
  listId String
  name String
  quantity String @default("")
  budget Int?
  reason String @default("")
  requirements String @default("")
  concerns String @default("")
  alternatives String @default("")
  timing String @default("")
  note String @default("")
  originalText String @default("")
  status String @default("considering")
  ledgerId String?
  ownedItemId String?
  sourceDraftId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([ownerId, listId])
}

model OwnedItem {
  id String @id @default(cuid())
  ownerId String
  name String
  purchaseDate String
  retiredDate String?
  price Int
  recovery Int @default(0)
  ledgerId String?
  note String @default("")
  mode String @default("day")
  sourceDraftId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([ownerId])
}

model UsageLog {
  id String @id @default(cuid())
  ownerId String
  itemId String
  count Int
  date String
  createdAt DateTime @default(now())
  @@index([ownerId, itemId])
}

model SavingEntry {
  id String @id @default(cuid())
  ownerId String
  title String
  type String
  source String @default("manual")
  date String
  planned Int?
  actual Int?
  amount Int
  note String @default("")
  ledgerId String?
  shoppingItemId String?
  sourceKey String? @unique
  status String @default("valid")
  suppressed Boolean @default(false)
  sourceDraftId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([ownerId, date])
}

model CaptureDraft {
  id String @id @default(cuid())
  ownerId String
  text String
  target String @default("ledger")
  targetListId String?
  inputMethod String @default("text")
  capturedAt DateTime
  captureTimezone String @default("Asia/Shanghai")
  receivedAt DateTime @default(now())
  processedAt DateTime?
  appliedAt DateTime?
  state String @default("pending")
  result String @default("[]")
  appliedIndexes String @default("[]")
  warnings String @default("[]")
  error String?
  leaseId String?
  leaseAt DateTime?
  version Int @default(1)
  @@index([ownerId, state])
}

model Attachment {
  id String @id @default(cuid())
  ownerId String
  draftId String
  storageKey String
  name String
  mime String
  size Int
  hash String
  @@index([ownerId, draftId])
}

model ReviewRequest {
  id String @id @default(cuid())
  ownerId String
  itemId String
  title String
  description String @default("")
  publicInfo String @default("{}")
  targetCount Int
  rule String @default("majority")
  visibility String @default("link")
  token String @unique
  status String @default("open")
  version Int @default(1)
  createdAt DateTime @default(now())
  @@index([ownerId])
}

model ReviewVote {
  id String @id @default(cuid())
  reviewId String
  userId String
  username String
  approve Boolean
  comment String @default("")
  createdAt DateTime @default(now())
  @@unique([reviewId, userId])
}

model AppliedOperation {
  id String @id
  ownerId String
  kind String
  result String
  createdAt DateTime @default(now())
}

model AiAnalysis {
  id String @id @default(cuid())
  ownerId String
  hash String
  content String
  createdAt DateTime @default(now())
  @@index([ownerId, hash])
}
