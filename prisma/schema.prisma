generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String   @id @default(cuid())
  username                String   @unique
  passwordHash            String
  timezone                String   @default("Asia/Shanghai")
  preferences             String   @default("{}")
  autoBatch               Boolean  @default(false)
  batchSize               Int      @default(5)
  defaultExpenseAccountId String?
  createdAt               DateTime @default(now())
}

model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  maxUses   Int      @default(10)
  usedCount Int      @default(0)
  note      String   @default("")
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model InviteRedemption {
  id        String   @id @default(cuid())
  codeId    String
  code      String
  ownerId   String   @unique
  createdAt DateTime @default(now())

  @@index([codeId])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  @@index([userId])
}

model Account {
  id       String  @id @default(cuid())
  ownerId  String
  name     String
  opening  Int     @default(0)
  archived Boolean @default(false)
  version  Int     @default(1)

  @@index([ownerId])
}

model Category {
  id       String  @id @default(cuid())
  ownerId  String
  name     String
  type     String
  iconKey  String  @default("tag")
  color    String  @default("")
  archived Boolean @default(false)
  version  Int     @default(1)

  @@unique([ownerId, type, name])
}

model CategoryRule {
  id         String @id @default(cuid())
  ownerId    String
  keyword    String
  categoryId String

  @@unique([ownerId, keyword])
}

model LedgerEntry {
  id                   String   @id @default(cuid())
  ownerId              String
  type                 String
  title                String
  amount               Int
  date                 String
  accountId            String?
  toAccountId          String?
  categoryId           String?
  refundOfId           String?
  discount             Int      @default(0)
  grossAmount          Int?
  discountDetails      String   @default("")
  autoSaving           Boolean  @default(true)
  orderKey             String?
  note                 String   @default("")
  sourceDraftId        String?
  groupId              String?
  sourceShoppingItemId String?  @unique
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([ownerId, date])
  @@index([refundOfId])
  @@index([ownerId, groupId, date])
}

model ShoppingList {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  kind        String    @default("shopping")
  departureDate String?
  description String    @default("")
  archived    Boolean   @default(false)
  sort        Int       @default(0)
  budget      Int?
  savingMode  String    @default("item")
  closedAt    DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([ownerId])
}

model ShoppingItem {
  id                      String   @id @default(cuid())
  ownerId                 String
  listId                  String
  name                    String
  quantity                String   @default("")
  budget                  Int?
  reason                  String   @default("")
  requirements            String   @default("")
  concerns                String   @default("")
  alternatives            String   @default("")
  timing                  String   @default("")
  note                    String   @default("")
  originalText            String   @default("")
  status                  String   @default("considering")
  done                    Boolean  @default(false)
  groupName               String   @default("")
  categoryId              String?
  ledgerId                String?
  ownedItemId             String?
  purchaseAmount          Int?
  purchasedAt             String?
  purchaseAccountId       String?
  purchaseDiscount        Int?
  purchaseDiscountDetails String   @default("")
  purchaseRevision        Int      @default(0)
  purchaseNeedsReview     Boolean  @default(false)
  sourceDraftId           String?
  version                 Int      @default(1)
  createdAt               DateTime @default(now())

  @@index([ownerId, listId])
  @@index([ownerId, categoryId])
}

model OwnedItem {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  purchaseDate  String?
  retiredDate   String?
  price         Int?
  recovery      Int      @default(0)
  ledgerId      String?
  note          String   @default("")
  mode          String   @default("day")
  quantity      Int      @default(1)
  unit          String   @default("件")
  storageEnabled Boolean @default(false)
  expiryEnabled Boolean  @default(false)
  costEnabled   Boolean  @default(true)
  location      String   @default("")
  boxId         String?
  expiresOn     String?
  status        String   @default("active")
  sourceNote    String   @default("")
  quantityConfirmedAt DateTime?
  sourceDraftId String?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId])
  @@index([ownerId, boxId])
  @@index([ownerId, expiresOn])
}

model StorageBox {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  location  String   @default("")
  note      String   @default("")
  color     String   @default("")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ReminderRule {
  id          String   @id @default(cuid())
  ownerId     String
  targetType  String
  targetId    String
  triggerType String
  fixedAt     DateTime?
  offsetDays  Int?
  localTime   String   @default("09:00")
  timezone    String   @default("Asia/Shanghai")
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, targetType, targetId])
}

model ReminderOccurrence {
  id          String    @id @default(cuid())
  ownerId     String
  ruleId      String
  targetType  String
  targetId    String
  dedupeKey   String    @unique
  dueAt       DateTime
  state       String    @default("pending")
  handledAt   DateTime?
  snoozedUntil DateTime?
  anchorDate  String?
  createdAt   DateTime  @default(now())

  @@index([ownerId, state, dueAt])
}

model UsageLog {
  id        String   @id @default(cuid())
  ownerId   String
  itemId    String
  count     Int
  date      String
  createdAt DateTime @default(now())

  @@index([ownerId, itemId])
}

model SavingEntry {
  id                       String   @id @default(cuid())
  ownerId                  String
  title                    String
  type                     String
  source                   String   @default("manual")
  date                     String
  planned                  Int?
  actual                   Int?
  amount                   Int
  note                     String   @default("")
  ledgerId                 String?
  shoppingItemId           String?
  sourceKey                String?  @unique
  status                   String   @default("valid")
  suppressed               Boolean  @default(false)
  sourceDraftId            String?
  groupId                  String?
  sourceListId             String?
  settlementId             String?  @unique
  supersededBySettlementId String?
  version                  Int      @default(1)
  createdAt                DateTime @default(now())

  @@index([ownerId, date])
  @@index([ownerId, groupId, date])
  @@index([ownerId, sourceListId])
}

model RecordGroup {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  sourceListId  String?  @unique
  sourceDeleted Boolean  @default(false)
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([ownerId])
}

model ListSettlement {
  id          String    @id @default(cuid())
  ownerId     String
  listId      String    @unique
  budget      Int
  paid        Int
  members     String
  status      String    @default("pending")
  confirmedAt DateTime?
  version     Int       @default(1)

  @@index([ownerId])
}

model UserAiConfig {
  id           String  @id @default(cuid())
  ownerId      String  @unique
  enabled      Boolean @default(false)
  baseUrl      String
  encryptedKey String
  textModel    String
  visionModel  String  @default("")
  version      Int     @default(1)
}

model AiDailyUsage {
  id        String @id @default(cuid())
  ownerId   String
  quotaDate String
  reserved  Int    @default(0)
  used      Int    @default(0)

  @@unique([ownerId, quotaDate])
}

model AiTask {
  id           String   @id @default(cuid())
  ownerId      String
  operationId  String
  kind         String
  providerMode String
  quotaDate    String
  input        String
  result       String   @default("null")
  status       String   @default("running")
  error        String?
  leaseId      String
  leaseUntil   DateTime
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([ownerId, operationId])
  @@index([ownerId, status])
}

model CaptureDraft {
  id              String    @id @default(cuid())
  ownerId         String
  text            String
  target          String    @default("ledger")
  targetListId    String?
  inputMethod     String    @default("text")
  capturedAt      DateTime
  captureTimezone String    @default("Asia/Shanghai")
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  appliedAt       DateTime?
  updatedAt       DateTime  @default(now()) @updatedAt
  state           String    @default("pending")
  result          String    @default("[]")
  appliedIndexes  String    @default("[]")
  warnings        String    @default("[]")
  error           String?
  leaseId         String?
  leaseAt         DateTime?
  version         Int       @default(1)

  @@index([ownerId, state])
}

model Attachment {
  id         String @id @default(cuid())
  ownerId    String
  draftId    String
  storageKey String
  name       String
  mime       String
  size       Int
  hash       String
  missing    Boolean @default(false)

  @@index([ownerId, draftId])
}

model ExchangeDataset {
  id      String @id @default(cuid())
  ownerId String @unique
}

model ImportIdentity {
  id               String @id @default(cuid())
  ownerId          String
  datasetId        String
  entity           String
  sourceId         String
  localId          String
  fingerprint      String
  localFingerprint String
  sourceContent    String

  @@unique([ownerId, datasetId, entity, sourceId])
  @@index([ownerId, localId])
}

model ImportJob {
  id        String   @id @default(cuid())
  ownerId   String
  fileHash  String
  payload   String
  preview   String
  status    String   @default("preview")
  result    String   @default("null")
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([ownerId, status])
}

model ReviewRequest {
  id          String   @id @default(cuid())
  ownerId     String
  itemId      String
  title       String
  description String   @default("")
  publicInfo  String   @default("{}")
  targetCount Int
  rule        String   @default("majority")
  visibility  String   @default("link")
  token       String   @unique
  status      String   @default("open")
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  username  String
  approve   Boolean
  comment   String   @default("")
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
}

model AppliedOperation {
  id        String   @id
  ownerId   String
  kind      String
  result    String
  createdAt DateTime @default(now())
}

model AiAnalysis {
  id        String   @id @default(cuid())
  ownerId   String
  hash      String
  content   String
  createdAt DateTime @default(now())

  @@index([ownerId, hash])
}
